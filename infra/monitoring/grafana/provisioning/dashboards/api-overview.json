{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "OTP Sent",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "auth_otp_sent_total" }]
    },
    {
      "title": "Queue Messages",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "sum(queue_messages_total)" }]
    }
  ],
  "schemaVersion": 39,
  "title": "Rimskiy API Overview",
