# Скопируйте в secret.yaml и заполните реальными значениями (не коммитьте secret.yaml!)
apiVersion: v1
kind: Secret
metadata:
  name: rimskiy-secrets
  namespace: rimskiy
type: Opaque
stringData:
  DATABASE_URL: postgresql://rimskiy:CHANGE_ME@postgres:5432/rimskiy
  JWT_SECRET: change-me-min-32-chars
  ENCRYPTION_KEY: change-me-64-hex-chars
  INTERNAL_API_TOKEN: change-me-internal-token
  TELEGRAM_BOT_TOKEN: ""
  RABBITMQ_PASSWORD: change-me
  POSTGRES_PASSWORD: change-me
