# Скопируйте в secret.yaml и заполните реальными значениями (не коммитьте secret.yaml!)
# kubectl create secret generic rimskiy-secrets -n rimskiy --from-env-file=...
#
# Обязательные ключи согласованы с configmap + backend-deployment envFrom.
# METRICS_AUTH_* нужны только если /metrics доступен снаружи.
apiVersion: v1
kind: Secret
metadata:
  name: rimskiy-secrets
  namespace: rimskiy
type: Opaque
stringData:
  DATABASE_URL: postgresql://rimskiy:CHANGE_ME@postgres:5432/rimskiy
  # JWT_SECRET: минимум 32 символа
  JWT_SECRET: change-me-jwt-secret-min-32-chars!!
  # ENCRYPTION_KEY: ровно 64 hex (openssl rand -hex 32)
  ENCRYPTION_KEY: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  INTERNAL_API_TOKEN: change-me-internal-token
  POSTGRES_PASSWORD: change-me
  RABBITMQ_PASSWORD: change-me
  # Опционально
  TELEGRAM_BOT_TOKEN: ""
  FCM_SERVER_KEY: ""
  OCR_API_URL: ""
  SMS_API_URL: ""
  SMS_API_KEY: ""
  METRICS_AUTH_USER: prometheus
  METRICS_AUTH_PASSWORD: change-me-metrics
