# Docker Compose secrets — copy to `.env` before `docker compose up`
# cp .env.docker.example .env

# --- Required ---
POSTGRES_USER=rimskiy
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=rimskiy

RABBITMQ_USER=rimskiy
RABBITMQ_PASSWORD=change-me-rabbitmq

# JWT_SECRET: минимум 32 символа
JWT_SECRET=change-me-jwt-secret-min-32-chars!!

# ENCRYPTION_KEY: ровно 64 hex-символа (32 байта)
# openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Backend → telegram-bot /send_code
INTERNAL_API_TOKEN=change-me-internal-token

# --- App ---
APP_ENV=production
RETURN_SMS_CODE_IN_RESPONSE=false
WEB_APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
RUST_LOG=info
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_MINUTES=10080

# --- Optional: Telegram bot (profile: bot) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# --- Optional: OCR / FCM / SMS ---
# OCR_API_URL=https://ocr-provider.example.com/recognize
# FCM_SERVER_KEY=
# SMS_API_URL=
# SMS_API_KEY=

# --- Optional: observability (profile: obs) ---
# GRAFANA_PASSWORD=admin
