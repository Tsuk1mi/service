# Database
DATABASE_URL=postgresql://rimskiy_postgres:Rimskiy_PG@localhost/rimskiy

# JWT Authentication
JWT_SECRET=dy3omehq0jASepMWvfA2Zbh02toOZff9
JWT_EXPIRATION_MINUTES=10080
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_MINUTES=10080

# App environment (development | production)
APP_ENV=development

# Redis (OTP store, rate limiting)
# REDIS_URL=redis://localhost:6379

# RabbitMQ (async notifications)
# RABBITMQ_URL=amqp://rimskiy:password@localhost:5672/rimskiy

# CORS (comma-separated origins)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Encryption (must be exactly 64 hex characters = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Migrations
MIGRATIONS_PATH=./migrations

# SMS Configuration
SMS_CODE_EXPIRATION_MINUTES=10
SMS_CODE_LENGTH=4
RETURN_SMS_CODE_IN_RESPONSE=false
# Для включения отправки реальных SMS достаточно указать URL провайдера
# (опционально SMS_API_KEY, если требуется провайдером)
# SMS_API_URL=https://sms-provider.example.com/send
# SMS_API_KEY=your-sms-api-key

# Telephony Configuration (for calling blocked car owners)
# Optional: Set these if you want to enable phone calls to notify blocked car owners
# TELEPHONY_API_URL=https://api.telephony-provider.com/call
# TELEPHONY_API_KEY=your-telephony-api-key

# Web Application
# URL веб-клиента (используется в /server-info и Telegram-боте /apk)
# WEB_APP_URL=https://example.com

# Telegram Bot Configuration
# Required: Token for Telegram bot (get it from @BotFather)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Optional: Username of the Telegram bot
# TELEGRAM_BOT_USERNAME=your_bot_username
# Optional: Base URL for API (used by telegram bot, default: http://SERVER_HOST:SERVER_PORT)
# API_BASE_URL=http://localhost:8080

# Docker: URL HTTP-эндпоинта бота для доставки кодов (в compose: http://telegram-bot:8081/send_code)
# TELEGRAM_BOT_HTTP_URL=http://telegram-bot:8081/send_code

# SMS Provider Configuration (for automatic SMS sending)
# Optional: If not set, codes will only be sent via Telegram
# SMS_API_URL=https://api.sms-provider.com/send
# SMS_API_KEY=your-sms-api-key-here

# Docker Compose (см. .env.docker.example)
# POSTGRES_USER=rimskiy
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=rimskiy
# RABBITMQ_USER=rimskiy
# RABBITMQ_PASSWORD=change-me

# Internal API token (backend -> telegram-bot /send_code)
# INTERNAL_API_TOKEN=change-me-internal-token

# Metrics basic auth (optional)
# METRICS_AUTH_USER=prometheus
# METRICS_AUTH_PASSWORD=change-me

# OTP rate limits
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_SECS=900
OTP_VERIFY_MAX_ATTEMPTS=5
