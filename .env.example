# Database
DATABASE_URL=postgresql://postgres:your_password@localhost/rimskiy

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
# 7 дней
JWT_EXPIRATION_MINUTES=10080

# Encryption (must be exactly 64 hex characters = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Migrations
MIGRATIONS_PATH=./migrations

# SMS Configuration
SMS_CODE_EXPIRATION_MINUTES=10
SMS_CODE_LENGTH=4
RETURN_SMS_CODE_IN_RESPONSE=true

# Telegram Gateway (verification via Telegram, альтернативно SMS)
# Включите, чтобы отправлять коды через Telegram Gateway API на номер телефона.
# Требуется пополненный баланс в Telegram Gateway и наличие Telegram у пользователя.
# TELEGRAM_GATEWAY_TOKEN=your-telegram-gateway-token
# Optional: base URL (по умолчанию https://gatewayapi.telegram.org/)
# TELEGRAM_GATEWAY_BASE_URL=https://gatewayapi.telegram.org/

# Telephony Configuration (for calling blocked car owners)
# Optional: Set these if you want to enable phone calls to notify blocked car owners
# TELEPHONY_API_URL=https://api.telephony-provider.com/call
# TELEPHONY_API_KEY=your-telephony-api-key

# App Download Configuration
# Optional: Path to APK file OR directory with multiple versions.
# If a directory is set, the server will automatically pick the latest app-release-vX.Y.Z.apk.
# Default: ./android/app/build/outputs/apk/release/app-release.apk
# APP_APK_PATH=/opt/rimskiy-service/apk
# Optional: URL for app download (used in server-info endpoint)
# APP_DOWNLOAD_URL=http://your-server.com/api/app/download

# App Version Configuration
# Optional: Minimum required client version (forces update if client version is lower)
# MIN_CLIENT_VERSION=1.0.0
# Optional: Latest release client version (shows optional update dialog if client version is lower)
# RELEASE_CLIENT_VERSION=1.1.0

# Telegram Bot Configuration
# Required: Token for Telegram bot (get it from @BotFather)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Optional: Username of the Telegram bot (for app update dialogs)
# TELEGRAM_BOT_USERNAME=your_bot_username

# SMS Provider Configuration (for automatic SMS sending)
# Optional: если настроено, можно использовать внешний SMS провайдер (не рекомендуется, если вы используете Telegram Gateway)
# SMS_API_URL=https://api.sms-provider.com/send
# SMS_API_KEY=your-sms-api-key-here

